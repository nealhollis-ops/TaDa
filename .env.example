# ---------------------------------------------------------------
# TaDa environment variables
# Copy this file to .env.local and fill in the values.
# Add the same keys in Vercel > Project > Settings > Environment Variables.
# Never commit .env.local (it is git-ignored).
# ---------------------------------------------------------------

# Public app URL (no trailing slash). Used for magic links, Stripe redirects, emails.
NEXT_PUBLIC_APP_URL=https://app.gettada.me

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Paste either the "anon" key or the newer "publishable" key here (both work)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (server only, never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (use TEST keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Anthropic (brain dump + talk-to-the-calendar bar)
ANTHROPIC_API_KEY=

# Resend (transactional email). FROM must be on a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM="TaDa <hello@mail.gettada.me>"

# Web Push (Phase 3). Generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:clientcare@gettada.me

# Seed script (scripts/seed-admins.mjs): founders who get admin + Boss forever.
# Format: email:Name,email:Name
SEED_ADMIN_EMAILS=debhollis1@gmail.com:Deb,neal.hollis@gmail.com:Neal
